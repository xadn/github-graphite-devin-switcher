{
  "name": "GitHub Graphite Devin Switcher",
  "description": "Cross-links PR pages between GitHub, Graphite, and Devin — jump to the same PR on any surface",
  "version": "0.1",
  "manifest_version": 3,
  "icons": {
    "16": "icons/icon16-v6.png",
    "48": "icons/icon48-v6.png",
    "128": "icons/icon128-v6.png"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["*://github.com/*"],
      "js": ["common.js", "github.js"]
    },
    {
      "matches": ["*://app.graphite.dev/*", "*://app.graphite.com/*"],
      "js": ["common.js", "graphite.js"]
    },
    {
      "matches": [
        "*://devinreview.com/*",
        "*://app.devin.ai/*",
        "*://*.devinenterprise.com/*"
      ],
      "js": ["common.js", "devinreview.js"]
    }
  ]
}
